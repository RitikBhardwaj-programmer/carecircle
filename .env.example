# Copy to .env for local development. Never commit .env.

# Signs session cookies and one-tap dose links (>= 32 random chars). Cloud Run reads it from Secret Manager.
SESSION_SECRET=

# Public base URL used in email links and as the cron OIDC audience.
APP_URL=http://localhost:3005

# Data store: "firestore" (default in production) or "memory" (local demo, data lost on restart).
DATA_STORE=memory
GOOGLE_CLOUD_PROJECT=catalyst-rb-6290

# Gemini: Vertex AI with Application Default Credentials is used when GEMINI_API_KEY is empty.
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Gmail SMTP with an app password. If empty, the mailer runs in dry-run mode and only logs.
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Cron: service account email Cloud Scheduler signs its OIDC token with.
CRON_INVOKER_EMAIL=carecircle-scheduler@catalyst-rb-6290.iam.gserviceaccount.com
# Local only: lets `curl -H "x-cron-key: ..."` call the cron route without OIDC. Leave empty in production.
CRON_DEV_KEY=
